# Copia este archivo como .env (no se versiona) y completa la clave.

# --- DeepSeek (implementador) ---
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-flash
# Precios USD por millón de tokens (tarifa pico; fuera de pico es la mitad)
DEEPSEEK_PRECIO_IN=0.30
DEEPSEEK_PRECIO_OUT=1.20

# --- Rutas ---
PROYECTO_DIR=D:/Daniel/Desarrollo/Web_Dinosaurios
# Los handoffs para Agy se crean en VAULT_DIR/_pendiente-documentar
VAULT_DIR=D:/Daniel/Obsidian/Data/99_AI/00_Inbox
NOTA_PROYECTO=D:/Daniel/Obsidian/Data/00_Human/02_Second_Brain/Software/05_Projects/18_Web_Dinosaurios/Indice.md
TAREAS=tareas.md
MAX_REINTENTOS=2
# Compilación antes de la revisión de Claude; si falla, DeepSeek corrige sin gastar revisión
VERIFICAR_CMD=dotnet build -nologo -v q

# Vacío: Agy procesa los handoffs en lote (ver SOP en la bóveda)
AGY_CMD=
