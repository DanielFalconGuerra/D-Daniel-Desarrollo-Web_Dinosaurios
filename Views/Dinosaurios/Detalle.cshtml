@model Dinosaurio

@{
    ViewData["Title"] = Model.Nombre;

    var clasePeriodo = Model.Periodo.StartsWith("Jurásico") ? "dino-jurasico"
        : Model.Periodo.StartsWith("Cretácico") ? "dino-cretacico"
        : "dino-periodo-otro";
    var textoFuente = Model.FuenteUrl.Contains("wikipedia.org") ? "Leer en Wikipedia" : "Leer la fuente";
}

<p class="dino-volver"><a asp-action="Index">← Volver al catálogo</a></p>

<article class="@clasePeriodo">
    <div class="dino-ficha__franja">
        <span>@Model.Periodo</span>
        <span>@Model.Antiguedad</span>
    </div>

    <h1 class="dino-ficha__nombre dino-nombre-cientifico">@Model.Nombre</h1>

    <div class="row g-4 g-lg-5">
        <div class="col-12 col-lg-7">
            <figure class="mb-0">
                <img class="dino-ficha__imagen" src="@Model.ImagenUrl" alt="Ilustración de @Model.Nombre" />
                @if (!string.IsNullOrWhiteSpace(Model.CreditoImagen))
                {
                    <figcaption class="dino-ficha__credito">Imagen: @Model.CreditoImagen</figcaption>
                }
            </figure>
        </div>
        <div class="col-12 col-lg-5">
            <p class="dino-ficha__descripcion">@Model.Descripcion</p>

            <dl class="dino-datos">
                <dt>Periodo</dt>
                <dd>@Model.Periodo</dd>
                <dt>Antigüedad</dt>
                <dd>@Model.Antiguedad</dd>
                <dt>Región</dt>
                <dd>@Model.Region</dd>
                <dt>Dieta</dt>
                <dd>@Model.Dieta</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.FuenteUrl))
            {
                <a class="dino-ficha__fuente" href="@Model.FuenteUrl" target="_blank" rel="noopener noreferrer">@textoFuente</a>
            }
        </div>
    </div>
</article>
