@model IReadOnlyList<Dinosaurio>

@{
    ViewData["Title"] = "Catálogo de dinosaurios";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="mb-1">Catálogo de dinosaurios</h1>
        <p class="text-muted mb-0">@Model.Count especies registradas</p>
    </div>
    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">
        Todavía no hay dinosaurios en el catálogo.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
        @foreach (var dinosaurio in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <img src="@dinosaurio.ImagenUrl"
                         class="card-img-top"
                         alt="@dinosaurio.Nombre"
                         style="height: 220px; object-fit: cover;" />
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-2">@dinosaurio.Nombre</h5>
                        <div class="mb-3">
                            <span class="badge bg-secondary me-1">@dinosaurio.Periodo</span>
                            <span class="badge bg-success">@dinosaurio.Dieta</span>
                        </div>
                        <p class="card-text text-secondary mb-0">@dinosaurio.Descripcion</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
